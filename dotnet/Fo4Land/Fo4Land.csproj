<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Fallout4" Version="0.55.0-alpha.67" />
  </ItemGroup>

  <!-- export-exterior writes the same schema v2 placement JSON as dotnet/Fo4Export (Codex's): its serializers are
       compiled in from their source files, unchanged, so the two exporters cannot drift apart. -->
  <ItemGroup>
    <Compile Include="..\Fo4Export\ReferenceExport.cs" Link="Fo4Export\ReferenceExport.cs" />
    <Compile Include="..\Fo4Export\KeywordExport.cs" Link="Fo4Export\KeywordExport.cs" />
    <Compile Include="..\Fo4Export\TeleportDependencies.cs" Link="Fo4Export\TeleportDependencies.cs" />
  </ItemGroup>

</Project>
